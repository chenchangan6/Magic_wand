# ESP-IDF generated files
**/build/
**/sdkconfig.old

# JavaScript/Python dependency and cache folders
**/node_modules/
**/__pycache__/
*.pyc
**/serve_debug.log

# Managed dependencies are generated by ESP-IDF Component Manager by default.
**/managed_components/

# Keep the receiver led_strip copy for now because it contains the ESP-IDF v6 compatibility patch.
!firmware/receiver/managed_components/
!firmware/receiver/managed_components/**

# Local configuration snapshots
lan_config/magic_wand_config.json
**/magic_wand_config.json
**/magic_wand_local_state.json
**/magic_wand_game_sessions.jsonl

# Local UI verification screenshots
**/ui_check.png
lan_config/*preview*.png
lan_config/effects_page_after.png
lan_config/header-check.png

# Editor/system noise
**/.vscode/
**/.clangd
desktop.ini
